{
	"schemaVersion": 1,
	"id": "typestones",
	"version": "${version}",
	"name": "Typestones",
	"description": "Smooth stone blocks with a letter in two dye colors, and picture stones that show an image, made by the Typewriter from a typed line of text or from an image a program sends it.",
	"authors": [
		"Claude",
		"Konitor"
	],
	"contact": {
		"homepage": "https://github.com/Knito58/Typestones",
		"sources": "https://github.com/Knito58/Typestones",
		"issues": "https://github.com/Knito58/Typestones/issues"
	},
	"license": "MIT",
	"icon": "assets/typestones/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.knito.typestones.Typestones"
		],
		"client": [
			"de.knito.typestones.client.TypestonesClient"
		],
		"modmenu": [
			"de.knito.typestones.client.config.ModMenuEntry"
		]
	},
	"mixins": [
		{
			"config": "typestones.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"billboard_api": "*",
		"computercraft": "*",
		"modmenu": "*"
	}
}
